# Variables de Entorno del Backend (Node.js / Express + PostgreSQL Supabase)
# Copiar este archivo como "backend/.env" en local o cargarlas en Render > Environment.

# Puerto HTTP (Render inyecta su propio process.env.PORT automáticamente en producción)
PORT=4000
NODE_ENV=development

# Cadena de conexión a PostgreSQL (Supabase Session Pooler IPv4 - Puerto 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# SSL requerido para conexiones remotas a Supabase
DATABASE_SSL=true

# Origen permitido por CORS
CORS_ORIGIN=http://localhost:3000

# Configuración SMTP opcional para envío de correos reales con Nodemailer
# (Si se omiten, el backend utiliza simulación JSON segura sin interrumpir el registro en BD)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-password-de-aplicacion
SMTP_FROM="LOTUS Portfolio <no-reply@lotus.dev>"
